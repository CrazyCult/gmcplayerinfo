{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmc-companion-index",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "keep_vars": true,
  // Turso : URL de la base (le jeton se met avec
  // `npx wrangler secret put TURSO_TOKEN`, jamais ici).
  // Budget d'écritures par jour (offre gratuite Turso : 10 M par mois).
  "vars": {
    "TURSO_URL": "libsql://REMPLACER.turso.io",
    "DAILY_WRITE_BUDGET": "250000"
  },
  "ratelimits": [{
    "name": "SITE_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 300, "period": 60 }
  }]
}
